# Server Configuration
PORT=3000

# AI Provider - Gemini (BEDAVA!)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Cloud Speech-to-Text (BEDAVA - Ayda 60 dakika!)
# Ses kaydı için - aynı key'i kullanabilirsiniz veya ayrı alabilirsiniz
GOOGLE_CLOUD_API_KEY=your_google_cloud_api_key_here

# AI Provider - Groq (Llama 3 - Ultra Hızlı & Ücretsiz Beta)
GROQ_API_KEY=your_groq_api_key_here

# AI Provider - OpenAI (Optional - Ücretli)
OPENAI_API_KEY=your_openai_api_key_here

# Firebase Admin SDK (Optional)
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=your_client_email
FIREBASE_PRIVATE_KEY="your_private_key"

# Claude (Optional)
CLAUDE_API_KEY=your_claude_api_key_here
